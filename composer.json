{
    "name": "ksfraser/ksf-fa-purchase-order-tracking",
    "description": "FrontAccounting Purchase Order Tracking - tracks PO lead times and fill rates",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-common-db": "^1.0",
        "ksfraser/exceptions": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "ksfraser/famock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\FrontAccounting\\PurchaseOrderTracking\\": "src/Ksfraser/FrontAccounting/PurchaseOrderTracking/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\FrontAccounting\\PurchaseOrderTracking\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}